#!/usr/bin/env bash
# Enforces Conventional Commits per AGENTS.md section 21.
# Allowed prefixes: feat, fix, refactor, docs, test, perf, style, chore.
# Optional scope (format: `type(scope):`), optional `!` for breaking changes.
# Merge and Revert commits produced by git are exempt.
# Bypass with `git commit --no-verify` or `SKIP_QC=1 git commit`.
set -eu

[ -n "${SKIP_QC:-}" ] && exit 0

msg_file="${1:-}"
[ -n "$msg_file" ] || exit 0

first="$(head -n1 "$msg_file")"

case "$first" in
  Merge\ * | Merge:* | Revert\ * | Revert:) exit 0 ;;
esac

if printf '%s\n' "$first" | grep -Eq '^(feat|fix|refactor|docs|test|perf|style|chore)(\([a-z0-9._/-]+\))?!?: .+'; then
  exit 0
fi

cat >&2 <<'EOF'
ERROR: commit message must follow Conventional Commits (see AGENTS.md section 21).

  Expected:  <type>(<scope>): <description>      e.g. feat(parser): add option
  Allowed types: feat, fix, refactor, docs, test, perf, style, chore
  Breaking:   <type>!: <description> | <type>(<scope>)!: <description>

To bypass (emergency/rebase), push SKIP_QC=1 or use --no-verify.
EOF
exit 1